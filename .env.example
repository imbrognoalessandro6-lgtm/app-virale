# Copia questo file in ".env" e compila i valori.
# Senza Supabase l'app funziona in "modalità locale" (dati solo sul telefono, niente IA né inviti).

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat → Project → API keys (chiavi pubbliche dell'app iOS e Android)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Link allo store mostrato nei messaggi di invito (es. pagina web con i due link)
EXPO_PUBLIC_SHARE_URL=
